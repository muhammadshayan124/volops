{
  "uid": "volops-main",
  "title": "volops: FX volatility service",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Data age (days)", "gridPos": {"h": 4, "w": 5, "x": 0, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "volops_data_age_days", "refId": "A"}],
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 3}, {"color": "red", "value": 5}]}}}},
    {"id": 2, "type": "stat", "title": "Input drift share", "gridPos": {"h": 4, "w": 5, "x": 5, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "volops_monitor_drift_share", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.25}, {"color": "red", "value": 0.5}]}}}},
    {"id": 3, "type": "stat", "title": "Retrain recommended", "gridPos": {"h": 4, "w": 5, "x": 10, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "volops_monitor_retrain_recommended", "refId": "A"}],
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "no"}, "1": {"text": "YES"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}},
    {"id": 4, "type": "stat", "title": "Model", "gridPos": {"h": 4, "w": 9, "x": 15, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "volops_model_info", "legendFormat": "{{version}} (trained through {{trained_through}})", "refId": "A"}],
     "options": {"textMode": "name"}},
    {"id": 5, "type": "bargauge", "title": "Rolling QLIKE gain vs constant-variance benchmark (positive = model earns its place; only evidence where out-of-sample origins >= 20)", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "volops_monitor_qlike_gain", "legendFormat": "{{series}}", "refId": "A"}],
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0}]}}}},
    {"id": 6, "type": "timeseries", "title": "Latest forecast daily volatility (%)", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "volops_forecast_daily_vol_pct", "legendFormat": "{{currency}} h={{horizon}}", "refId": "A"}]},
    {"id": 9, "type": "table", "title": "Out-of-sample origins scored per series (0 right after a retrain: the gain panel is then not evidence)", "gridPos": {"h": 6, "w": 24, "x": 0, "y": 20},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "volops_monitor_out_of_sample_origins", "legendFormat": "{{series}}", "refId": "A", "instant": true, "format": "table"}]},
    {"id": 7, "type": "timeseries", "title": "Request rate by route and status", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [{"expr": "sum by (route, status) (rate(volops_requests_total[5m]))", "legendFormat": "{{route}} {{status}}", "refId": "A"}]},
    {"id": 8, "type": "timeseries", "title": "Latency p50 / p95 (s)", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
     "datasource": {"type": "prometheus", "uid": "prom"},
     "targets": [
       {"expr": "histogram_quantile(0.5, sum by (le) (rate(volops_request_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
       {"expr": "histogram_quantile(0.95, sum by (le) (rate(volops_request_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"}]}
  ]
}
